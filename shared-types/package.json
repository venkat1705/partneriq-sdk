{
  "name": "@partneriq-io/shared-types",
  "version": "1.1.0",
  "description": "TypeScript request, response and webhook event types for the PartnerIQ API (generated from @partneriq-io/node).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venkat1705/partneriq-sdk.git",
    "directory": "shared-types"
  },
  "bugs": {
    "url": "https://github.com/venkat1705/partneriq-sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck",
    "prepublishOnly": "npm run build && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "~7.0.2"
  },
  "homepage": "https://docs.partneriq.in/docs/sdk/node/types"
}
